@page "/weather/{id:int}"
@rendermode InteractiveServer

<PageTitle>Modo Editar</PageTitle>
<div class="container">
    <div class="card border-3">
        <EditForm Model="autorEditar" OnValidSubmit="EditaGuardar" FormName="Editar">
            <DataAnnotationsValidator />
            <div>
                <label>Nombre Autor</label>
                <InputText @bind-Value="autorEditar.Nombre" />
                <ValidationMessage class="text-bg-danger" For="@(() => autorEditar.Nombre)" />
            </div>

            <div>
                <label>Nacionalidad</label>
                <InputText @bind-Value="autorEditar.Nacionalidad" />
                <ValidationMessage class="text-bg-danger" For="@(() => autorEditar.Nacionalidad)" />
            </div>

            <div>
                <label>Fecha de Nacimiento</label>
                <InputText @bind-Value="autorEditar.FechaDeNacimiento" />
                <ValidationMessage class="text-bg-danger" For="@(() => autorEditar.FechaDeNacimiento)" />
            </div>

            <div>
                <label>Sueldo</label>
                <InputNumber @bind-Value="autorEditar.Sueldo" />
                <ValidationMessage class="text-bg-danger" For="@(() => autorEditar.Sueldo)" />
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <button type="button" class="btn btn-warning" @onclick="PaginaConsultar">Consultar</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    public List<Autores> autor { get; set; } = [];
    public Autores autorEditar { get; set; } = new();

    [Parameter]
    public int id{ get; set; }

    public async Task Edita(int id)
    {
        var Autor = await AutorService.Buscar(id);
        if(Autor != null)
        {
            autorEditar = Autor;
        }
    }
    public async Task EditaGuardar()
    {
        await AutorService.Editar(autorEditar);
        autor = await AutorService.GetList(A => true);
    }
    public void PaginaConsultar()
    {
        Navegacion.NavigateTo("/");
        
    }
}
