@page "/"
@rendermode InteractiveServer
<PageTitle>Consultar Autores</PageTitle>

<div class="container">

    <div class="d-flex justify-content-between ">
        <h4>Consultar</h4>
        <button class="btn btn-primary bi bi-plus-circle" @onclick="PaginaCrear">Crear</button>
    </div>

    <div class="card border-3">
        <div class="d-flex" style="gap:200px">
            <h6>Filtrar Por</h6>
            <h6>Busqueda</h6>
        </div>

        <div class="d-flex gap-5">

            <select style="width:200px" @bind="Filtro">
                <option>Id</option>
                <option>Autor</option>
                <option>Nacionalidad</option>
            </select>

            <input type="text" placeholder="Buscar" @bind="ValorFiltrar" />
            <button class="btn btn-warning bi bi-search" @onclick="Filtrar"></button>

        </div>
        <QuickGrid Items="autor.AsQueryable()" class="table table-bordered">
            <PropertyColumn Property="A=>A.Id" title="Id" Sortable="true"/>
            <PropertyColumn Property="A => A.Nombre" title="Autor" Sortable="true" />
            <PropertyColumn Property="A=>A.Nacionalidad" title="Nacionalidad" Sortable="true"/>
            <TemplateColumn Title="Fecha de Nacimiento">@context.FechaDeNacimiento</TemplateColumn>
            <PropertyColumn Property="A => A.Sueldo" title="Sueldo" Sortable="true" />
            <TemplateColumn title="Opciones">
                <div>
                    <button class="btn btn-warning bi bi-pencil"@onclick="()=>PaginaEditar(context.Id)"></button>
                    <button class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#Eliminar" @onclick="() => IdEliminar = context.Id"></button>
                </div>
            </TemplateColumn>
        </QuickGrid>
        <div>
          <h7>Cantidades de Autores: @autor.Count |</h7>
          <h7 class="">Total de Sueldo: @autor.Sum(A => A.Sueldo)</h7>
        </div>

    </div>
</div>
<div class="modal fade" id="Eliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Eliminacion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <h7>Seguro que quieres eliminar?</h7>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-warning" data-bs-dismiss="modal"> Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="Eliminar">Confirmar</button>

            </div>
        </div>
    </div>
</div>

@code{

    public List<Autores> autor { get; set; } = new();
    public string ValorFiltrar { get; set; } = string.Empty;
    public string Filtro { get; set; } = string.Empty;
    public int IdEliminar { get; set; }
    protected override async Task OnInitializedAsync()
    {
        autor = await AutorService.GetList(A => true);
    }
    public async Task Filtrar()
    {
        if (ValorFiltrar.Trim() != "")
        {
            if (Filtro == "Autor")
            {
                autor = await AutorService.GetList(A => A.Nombre.Contains(ValorFiltrar));
            }
            if (Filtro == "Nacionalidad")
            {
                autor = await AutorService.GetList(A => A.Nacionalidad.Contains(ValorFiltrar));
            }
            if (Filtro == "Id")
            {
                int.TryParse(ValorFiltrar, out int id);
                autor = await AutorService.GetList(A => A.Id==id);
            }
        }
    }
    public async Task Eliminar()
    {
        await AutorService.Eliminar(IdEliminar);
        autor = await AutorService.GetList(A => true);
    }

    public void PaginaEditar(int id)
    {
        Navegacion.NavigateTo($"/Edicion/{id}");
        
    }
    public void PaginaCrear()
    {
        Navegacion.NavigateTo("/Registro");

    }

}
