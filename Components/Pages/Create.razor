@page "/counter"
@rendermode InteractiveServer

<PageTitle>Registro</PageTitle>

<div class="container">
    <div class="card border-3">
        <EditForm Model="autor" OnValidSubmit="Guardar" FormName="Registro">
            <DataAnnotationsValidator/>
            <div>
                <label>Nombre Autor</label>
                <InputText @bind-Value="autor.Nombre"/>
                <ValidationMessage class="text-bg-danger" For="@(()=>autor.Nombre)"/>
            </div>

            <div>
                <label>Nacionalidad</label>
                <InputText @bind-Value="autor.Nacionalidad" />
                <ValidationMessage class="text-bg-danger" For="@(() => autor.Nacionalidad)" />
            </div>

            <div>
                <label>Fecha de Nacimiento</label>
                <InputText @bind-Value="autor.FechaDeNacimiento" />
                <ValidationMessage class="text-bg-danger" For="@(() => autor.FechaDeNacimiento)" />
            </div>

            <div>
                <label>Sueldo</label>
                <InputNumber @bind-Value="autor.Sueldo" />
                <ValidationMessage class="text-bg-danger" For="@(() => autor.Sueldo)" />
            </div>

            <div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <button type="button" class="btn btn-warning" @onclick="PaginaConsultar">Consultar</button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    public Autores autor { get; set; } = new();
    public String MensajeError { get; set; } = string.Empty;

    public async Task Guardar()
    {
        var Existe = await AutorService.GetList(A => A.Nombre == autor.Nombre);
        if (Existe.Count > 0)
        {
            MensajeError = "Ya ese Autor esta Registrado";
        }
        else
        {
            await AutorService.Guardar(autor);
        }

    }
    public void PaginaConsultar()
    {
        Navegacion.NavigateTo("/");
    }
}
